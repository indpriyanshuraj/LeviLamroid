@@ -0,0 +1,95 @@
+name: Build
+
+# CI only. Releases live in release.yml. xmake is the sole build system for
+# this project, so a green run here is the real thing.
+#
+# Target is Android ARM64 (arm64-v8a) only, matching LeviLaunchroid.
+
+on:
+  push:
+    branches: [main, master]
+  pull_request:
+  workflow_dispatch:
+
+permissions:
+  contents: read
+
+concurrency:
+  group: build-${{ github.workflow }}-${{ github.ref }}
+  cancel-in-progress: true
+
+env:
+  # GitHub Actions has no TTY; this forces true-colour output into the log.
+  XMAKE_COLORTERM: truecolor
+  NDK_VERSION: r28c
+  ABI: arm64-v8a
+
+jobs:
+  build:
+    name: android-${{ env.ABI }}
+    runs-on: ubuntu-latest
+    timeout-minutes: 30
+    steps:
+      - uses: actions/checkout@v4
+        with:
+          fetch-depth: 0
+
+      # One step wires up three caches:
+      #   actions-cache-folder -> the xmake binary itself
+      #   package-cache        -> the xrepo package store (~/.xmake/packages)
+      #   build-cache          -> the .build_cache object cache, and it turns
+      #                           build.ccache ON for CI (off by default there)
+      - name: Setup xmake (with caches)
+        uses: xmake-io/github-action-setup-xmake@v1
+        with:
+          xmake-version: latest
+          actions-cache-folder: ".xmake-cache"
+          actions-cache-key: ${{ runner.os }}-${{ env.ABI }}
+          package-cache: true
+          package-cache-key: ${{ runner.os }}-${{ env.ABI }}-${{ hashFiles('xmake.lua', 'xmake-requires.lock') }}
+          build-cache: true
+          build-cache-key: ${{ runner.os }}-${{ env.ABI }}
+          project-path: "."
+
+      - name: Setup Android NDK
+        id: ndk
+        uses: nttld/setup-ndk@v1
+        with:
+          ndk-version: ${{ env.NDK_VERSION }}
+
+      # Guard against the version drift that already exists in this repo
+      # (LeviLamroid.h said 1.0.0-beta while manifest.json said 1.0.1-beta).
+      - name: Check version consistency
+        run: python3 scripts/sync_version.py --check
+
+      - name: Configure
+        run: >
+          xmake f -p android -a ${{ env.ABI }} -m release
+          --ndk=${{ steps.ndk.outputs.ndk-path }} -y -v
+
+      - name: Build
+        run: xmake -y -v
+
+      - name: Summary
+        if: always()
+        run: |
+          {
+            echo "### LeviLamroid build - android-${{ env.ABI }}"
+            echo ""
+            echo "| Artifact | Size |"
+            echo "| --- | --- |"
+            for f in build/android/${{ env.ABI }}/release/liblevilamroid.so \
+                     build/android/${{ env.ABI }}/release/levilamroid.levipack; do
+              [ -f "$f" ] && echo "| $(basename "$f") | $(du -h "$f" | cut -f1) |"
+            done
+          } >> "$GITHUB_STEP_SUMMARY"
+
+      - name: Upload artifacts
+        uses: actions/upload-artifact@v4
+        with:
+          name: LeviLamroid-android-${{ env.ABI }}
+          path: |
+            build/android/${{ env.ABI }}/release/liblevilamroid.so
+            build/android/${{ env.ABI }}/release/levilamroid.levipack
+          if-no-files-found: error
+          retention-days: 14
diff --git a/.github/workflows/release.yml b/.github/workflows/release.yml
new file mode 100644
index 0000000..2a5b601
--- /dev/null
+++ b/.github/workflows/release.yml
@@ -0,0 +1,186 @@
+name: Release
+
+# Tag-driven release pipeline. Four gated stages, so a broken version or a
+# failed build never reaches the published release:
+#
+#   prepare -> resolve + validate the version (single source of truth)
+#   build   -> xmake build for android/arm64-v8a
+#   release -> publish two assets per release: the raw .so and the .levipack,
+#              plus SHA256SUMS
+#   attest  -> build provenance for the shipped binaries
+#
+# Target is Android ARM64 (arm64-v8a) only.
+
+on:
+  push:
+    tags: ["v*"]
+  workflow_dispatch:
+    inputs:
+      version:
+        description: "Version to release, e.g. 1.0.2-beta (must match the repo)"
+        required: true
+
+permissions:
+  contents: read
+
+# A release must never be cancelled mid-flight, so this does NOT cancel.
+concurrency:
+  group: release-${{ github.ref }}
+  cancel-in-progress: false
+
+env:
+  XMAKE_COLORTERM: truecolor
+  NDK_VERSION: r28c
+  ABI: arm64-v8a
+
+jobs:
+  prepare:
+    name: Validate version
+    runs-on: ubuntu-latest
+    outputs:
+      version: ${{ steps.resolve.outputs.version }}
+    steps:
+      - uses: actions/checkout@v4
+        with:
+          fetch-depth: 0
+
+      - name: Resolve version
+        id: resolve
+        run: |
+          if [ "${{ github.event_name }}" = "workflow_dispatch" ]; then
+            RAW="${{ github.event.inputs.version }}"
+          else
+            RAW="${GITHUB_REF_NAME}"
+          fi
+          V="${RAW#v}"
+          echo "version=$V" >> "$GITHUB_OUTPUT"
+          echo "Resolved version: $V"
+
+      - name: Verify version is consistent across the repo
+        run: python3 scripts/sync_version.py --check "${{ steps.resolve.outputs.version }}"
+
+  build:
+    name: android-${{ env.ABI }}
+    needs: prepare
+    runs-on: ubuntu-latest
+    timeout-minutes: 30
+    steps:
+      - uses: actions/checkout@v4
+        with:
+          fetch-depth: 0
+
+      - name: Setup xmake (with caches)
+        uses: xmake-io/github-action-setup-xmake@v1
+        with:
+          xmake-version: latest
+          actions-cache-folder: ".xmake-cache"
+          actions-cache-key: ${{ runner.os }}-${{ env.ABI }}
+          package-cache: true
+          package-cache-key: ${{ runner.os }}-${{ env.ABI }}-${{ hashFiles('xmake.lua', 'xmake-requires.lock') }}
+          build-cache: true
+          build-cache-key: ${{ runner.os }}-${{ env.ABI }}
+          project-path: "."
+
+      - name: Setup Android NDK
+        id: ndk
+        uses: nttld/setup-ndk@v1
+        with:
+          ndk-version: ${{ env.NDK_VERSION }}
+
+      - name: Configure
+        run: >
+          xmake f -p android -a ${{ env.ABI }} -m release
+          --ndk=${{ steps.ndk.outputs.ndk-path }} -y -v
+
+      - name: Build
+        run: xmake -y -v
+
+      # Two assets: the raw shared library and the packaged .levipack.
+      - name: Stage artifacts
+        run: |
+          V="${{ needs.prepare.outputs.version }}"
+          mkdir -p dist
+          cp build/android/${{ env.ABI }}/release/liblevilamroid.so \
+             "dist/LeviLamroid-${V}-android-${{ env.ABI }}.so"
+          cp build/android/${{ env.ABI }}/release/levilamroid.levipack \
+             "dist/LeviLamroid-${V}-android-${{ env.ABI }}.levipack"
+          ls -l dist
+
+      - name: Checksums
+        working-directory: dist
+        run: sha256sum * > SHA256SUMS.txt
+
+      - uses: actions/upload-artifact@v4
+        with:
+          name: dist
+          path: dist/*
+          if-no-files-found: error
+          retention-days: 7
+
+  release:
+    name: Publish release
+    needs: [prepare, build]
+    runs-on: ubuntu-latest
+    # `environment: release` lets you require a reviewer before anything is
+    # published; configure it under Settings -> Environments.
+    environment: release
+    permissions:
+      contents: write
+    steps:
+      - uses: actions/checkout@v4
+        with:
+          fetch-depth: 0
+
+      - uses: actions/download-artifact@v4
+        with:
+          name: dist
+          path: dist
+
+      - name: Compose release notes
+        run: |
+          V="${{ needs.prepare.outputs.version }}"
+          {
+            echo "## LeviLamroid v${V} - Android ARM64"
+            echo
+            echo "Native C++ mod-loader runtime for Minecraft Bedrock on LeviLauncher."
+            echo
+            echo "Supported Bedrock builds: 1.26.44.3 / 1.26.45.1 / 1.26.51.1 / 1.26.52.3."
+            echo
+            echo "### Assets"
+            echo
+            echo "- \`LeviLamroid-${V}-android-arm64-v8a.levipack\` - install this in LeviLauncher (contains \`liblevilamroid.so\`, \`manifest.json\`, \`data/\`)."
+            echo "- \`LeviLamroid-${V}-android-arm64-v8a.so\` - the raw shared library."
+            echo "- \`SHA256SUMS.txt\` - verify both downloads against it."
+            echo
+            echo "Full history: [CHANGELOG.md](CHANGELOG.md)."
+          } > RELEASE_NOTES.md
+          cat RELEASE_NOTES.md
+
+      - name: Publish
+        uses: softprops/action-gh-release@v2
+        with:
+          name: "LeviLamroid v${{ needs.prepare.outputs.version }}"
+          tag_name: v${{ needs.prepare.outputs.version }}
+          body_path: RELEASE_NOTES.md
+          files: dist/*
+          fail_on_unmatched_files: true
+          generate_release_notes: false
+
+  attest:
+    name: Build provenance
+    needs: [build, release]
+    runs-on: ubuntu-latest
+    permissions:
+      contents: read
+      id-token: write
+      attestations: write
+    steps:
+      - uses: actions/download-artifact@v4
+        with:
+          name: dist
+          path: dist
+      # Publishes a signed SLSA-style provenance record tying each .levipack and
+      # .so to this exact workflow run and commit.
+      - uses: actions/attest-build-provenance@v2
+        with:
+          subject-path: "dist/*.levipack, dist/*.so"
